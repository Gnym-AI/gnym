{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Semantic validation additionally checks nonblank text, lexical repository-relative paths, file membership, range order, unique reviewer identities and UTC RFC3339 timestamps. Locations are advisory; hunk placement is not checked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "comments"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "comments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comment"
      }
    }
  },
  "$defs": {
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "severity",
        "message"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "old",
            "new"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "dependentRequired": {
        "side": [
          "line"
        ],
        "line": [
          "side"
        ],
        "end_line": [
          "side",
          "line"
        ]
      }
    }
  }
}
